server {
    listen 80;
    server_name dashboards.ciabay.com.py;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name dashboards.ciabay.com.py;

    ssl_certificate     /etc/letsencrypt/live/dashboards.ciabay.com.py/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboards.ciabay.com.py/privkey.pem;

    root /var/www/ciabaymkt/public;
    index index.php;
    charset utf-8;

    # Un dashboard HTML puede pesar hasta 2 MB (ver config/dashboards.php).
    client_max_body_size 8m;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ^~ /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
